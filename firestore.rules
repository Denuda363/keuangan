rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid'])
        && data.uid is string && data.uid == request.auth.uid
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'date', 'type', 'amount', 'categoryId', 'accountId', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.type is string && (data.type == 'pemasukan' || data.type == 'pengeluaran')
        && data.amount is number && data.amount > 0
        && data.categoryId is string && isValidId(data.categoryId)
        && data.accountId is string && isValidId(data.accountId)
        && data.createdAt is number
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('recipientOrPayer' in data) || (data.recipientOrPayer is string && data.recipientOrPayer.size() <= 128));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'icon', 'color'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && (data.userId == request.auth.uid || data.userId == 'system')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.type is string && (data.type == 'pemasukan' || data.type == 'pengeluaran')
        && data.icon is string && data.icon.size() <= 64
        && data.color is string && data.color.size() <= 32
        && (!('description' in data) || (data.description is string && data.description.size() <= 256));
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && (data.userId == request.auth.uid || data.userId == 'system')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.type is string && (data.type == 'tunai' || data.type == 'bank' || data.type == 'ewallet')
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 64));
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow delete: if false;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidId(transactionId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && isValidTransaction(incoming());
      allow delete: if isSignedIn() && isValidId(transactionId) && existing().userId == request.auth.uid;
    }

    // Categories
    match /categories/{categoryId} {
      allow get: if isSignedIn() && isValidId(categoryId) && (existing().userId == request.auth.uid || existing().userId == 'system');
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'system');
      allow create: if isSignedIn() && isValidId(categoryId) && isValidCategory(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(categoryId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && isValidCategory(incoming());
      allow delete: if isSignedIn() && isValidId(categoryId) && existing().userId == request.auth.uid;
    }

    // Accounts / Wallets
    match /accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (existing().userId == request.auth.uid || existing().userId == 'system');
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'system');
      allow create: if isSignedIn() && isValidId(accountId) && isValidAccount(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(accountId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && isValidAccount(incoming());
      allow delete: if isSignedIn() && isValidId(accountId) && existing().userId == request.auth.uid;
    }
  }
}
